# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon key (หรือ publishable key) — ปลอดภัยที่จะอยู่ฝั่ง browser เพราะมี RLS คุมอยู่
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# service-role key: ใช้เฉพาะฝั่งเซิร์ฟเวอร์ (สร้างบัญชีพนักงาน) ห้ามใส่คำนำหน้า NEXT_PUBLIC_ เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- สมาชิก / LINE (ดู docs/MEMBERSHIP.md) — ทั้งหมดเป็นความลับฝั่งเซิร์ฟเวอร์ ยกเว้น NEXT_PUBLIC_LIFF_ID ----
NEXT_PUBLIC_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# สุ่มยาว ≥ 32 ตัวอักษร (เช่น openssl rand -base64 32) ใช้เซ็น QR สมาชิก
MEMBER_QR_SECRET=
# ใช้ป้องกัน /api/cron/outbox (ส่งเป็น Authorization: Bearer <ค่านี้>)
CRON_SECRET=
